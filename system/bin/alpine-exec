#!/system/bin/sh
#====================================================
# Alpine Linux Chroot - Exec Command
#====================================================

MODDIR="${0%/*}"

# Load common functions
if [ -f "$MODDIR/../common.sh" ]; then
    . "$MODDIR/../common.sh"
elif [ -f "/data/adb/modules/alpine_linux/common.sh" ]; then
    . "/data/adb/modules/alpine_linux/common.sh"
else
    echo "Error: Cannot load common.sh"
    exit 1
fi

# Execute command
if [ -z "$1" ]; then
    echo "Usage: alpine-exec <command>"
    echo "Example: alpine-exec apk update"
    exit 1
fi

alpine_exec "$@"

