#!/system/bin/sh
#====================================================
# Alpine Linux - Main Control Script (Patched)
#====================================================

MODDIR="${0%/*}"

# Load common functions (Fixed: add more path attempts)
if [ -f "$MODDIR/../common.sh" ]; then
    . "$MODDIR/../common.sh"
elif [ -f "/data/adb/modules/alpine_linux/common.sh" ]; then
    . "/data/adb/modules/alpine_linux/common.sh"
elif [ -f "/data/adb/modules/alpine-linux-magisk/common.sh" ]; then
    . "/data/adb/modules/alpine-linux-magisk/common.sh"
else
    echo "Error: Cannot load common.sh"
    echo "Please verify module is installed correctly"
    exit 1
fi

# Show help
show_help() {
    cat << EOF
Alpine Linux Control Tool v1.3.4

Usage: alpine <command> [args]

Container Management:
  start                     Start Alpine Linux
  stop                      Stop Alpine Linux
  restart                   Restart Alpine Linux
  status                    View running status
  shell                     Enter Alpine Linux shell
  exec <cmd>                Execute command in Alpine Linux

rootfs Management:
  download [arch] [ver] [mirror]  Auto download and install rootfs
  install <file>            Install rootfs from local file
  mirror <name>             Set APK mirror (tuna/ustc/official)

Mirrors:
  tuna     https://mirrors.tuna.tsinghua.edu.cn/alpine (default, fast Asia)
  ustc     https://mirrors.ustc.edu.cn/alpine (fast China)
  official https://dl-cdn.alpinelinux.org/alpine (official CDN)

Package Installation:
  install-pkg [basic|dev|net|tools|all]  Install packages
  install-hermes            One-click install Hermes Agent

Service Management:
  service add <name> [cmd]  Create service and enable auto-start
  service list              List all services
  service start <name>      Start service
  service stop <name>       Stop service
  service status <name>     View status
  service enable <name>     Enable auto-start
  service disable <name>    Disable auto-start
  service logs <name>       View logs
  service rm <name>         Remove service

SSH Service:
  ssh [port] [password]     One-click configure SSH
  ssh start|stop|restart|status  Manage SSH

Module Management:
  module-upgrade [zip]      Upgrade module
  module-version            View module version

Other:
  log                       View logs
  help                      Show help

Examples:
  alpine download
  alpine download aarch64 3.20.3 tuna
  alpine download aarch64 3.20.3 official
  alpine start
  alpine install-hermes
  alpine service add hermes
  alpine shell

ROOTFS PATH: \$RF
EOF
}

# Main logic
case "$1" in
    start) alpine_start ;;
    stop) alpine_stop ;;
    restart) alpine_stop; sleep 2; alpine_start ;;
    status) alpine_status ;;
    shell) alpine_shell ;;
    exec) shift; alpine_exec "$@" ;;
    download) shift; alpine_download "$@" ;;
    install) shift; alpine_install "$@" ;;
    install-pkg) shift; alpine_install_packages "$@" ;;
    install-hermes) alpine_install_hermes ;;
    service) shift; alpine_service "$@" ;;
    ssh) shift; alpine_ssh "$@" ;;
    mirror) shift; alpine_set_mirror "$@" ;;
    module-upgrade) shift; alpine_update "$@" ;;
    module-version) cat /data/adb/modules/alpine_linux/module.prop 2>/dev/null || cat /data/adb/modules/alpine-linux-magisk/module.prop 2>/dev/null || echo "Module not installed" ;;
    log) [ -f "$LOG" ] && tail -n 50 "$LOG" || echo "Log file not found" ;;
    help|--help|-h|"") show_help ;;
    *) err "Unknown command: $1"; show_help; exit 1 ;;
esac
